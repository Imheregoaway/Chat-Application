# Get token: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_your_token_here

# Inference provider (enable at huggingface.co/settings/inference-providers)
HF_PROVIDER=featherless-ai

# Chat model (Hugging Face Inference API)
HF_CHAT_MODEL=HuggingFaceH4/zephyr-7b-beta
HF_MAX_TOKENS=256
HF_TEMPERATURE=0.6

# Embedding model for ChromaDB vector search
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ChromaDB persistence directory (relative to backend/)
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION=knowledge

# RAG settings
RAG_TOP_K=4

# API server
API_HOST=0.0.0.0
API_PORT=8000
